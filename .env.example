# 必要なときだけ .env にコピーして値を変える（.env がなくても既定値で動く）

# 画面のポート（http://localhost:8080）
WEB_PORT=8080
# Kev API のポート（curl で直接試すとき用）
KEV_PORT=8008

# 使うモデル（Hugging Face のリポジトリ名。@リビジョン も指定可）
KEV_RUN=jaredpalmer/kev-0.8b

# 計算精度。bf16（既定・省メモリ） / fp32（メモリ約 2 倍。KEV_MEM_LIMIT も 5g 程度に上げる）
KEV_DTYPE=bf16
# Kev コンテナのメモリ上限。超えると Kev コンテナだけが停止する
KEV_MEM_LIMIT=3g
# 確率のなめらかさ。空 = モデル付属の校正済みの値。1 = 校正なし
KEV_TEMPERATURE=
# 1 = 文中の 2 つ以上の日付から「何日差か」を補ってから判定する（英語の日付形式のみ）
KEV_DATE_FACTS=0
# 1 = 長すぎる判断材料を切り詰めて判定する（0 = エラーにする）
KEV_TRUNCATE_STATES=0
